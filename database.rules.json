{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && (root.child('users').child(auth.uid).val() === 'gerant' || !data.exists())"
      }
    },
    "presences": {
      ".indexOn": [".key"],
      ".read": "auth != null",
      ".write": "auth != null && root.child('users').child(auth.uid).val() === 'gerant'"
    },
    "punches": {
      ".indexOn": [".key"],
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "settings": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('users').child(auth.uid).val() === 'gerant'"
    }
  }
}
